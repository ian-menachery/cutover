{
  "defects": [
    {
      "id": "B1",
      "title": "Account name not trimmed",
      "description": "Legacy CUST_NAME carries surrounding blanks (fixed-width padding) and the load skipped the trim step, so target account_name keeps the padding; the spec's text transform requires it trimmed."
    },
    {
      "id": "B2",
      "title": "Account name re-cased",
      "description": "A name-cleansing rule converted some uppercase legacy names to proper case (e.g. SMITH, JOHN -> Smith, John). The text transform only trims; case must be preserved."
    },
    {
      "id": "B3",
      "title": "Opened date day and month swapped",
      "description": "A batch of accounts was parsed as DD/MM/YYYY instead of MM/DD/YYYY. Where the day is 12 or less the result is still a valid date, so opened_on parses fine but has day and month swapped."
    },
    {
      "id": "B4",
      "title": "Account type valid but wrong",
      "description": "Some trust accounts (CUST_TYPE T) were loaded as account_type Individual: a valid picklist label, wrong for the row."
    },
    {
      "id": "B5",
      "title": "Optional state dropped",
      "description": "state was blanked on a few accounts whose legacy ST is populated. state is not required, but the spec maps it from ST, so a blank is a value discrepancy."
    },
    {
      "id": "B6",
      "title": "Duplicate account rows",
      "description": "A retried batch re-inserted some accounts: the same legacy_cust_no appears twice with a new account_id. The instance points at the second (appended) row."
    },
    {
      "id": "B7",
      "title": "Account missing from target",
      "description": "A legacy account has no target row. Accounts have no scope rule and no exception, so every account must migrate."
    },
    {
      "id": "B8",
      "title": "Account re-keyed (cross-reference transposed)",
      "description": "One account's legacy_cust_no was keyed with its last two digits transposed. The legacy account therefore has no target row (instance with target_row null) and the target row has no legacy counterpart (instance keyed by the bad cross-reference)."
    },
    {
      "id": "B9",
      "title": "Test account left in target",
      "description": "A test account with a blank legacy_cust_no is in the target. It has no legacy counterpart (key null)."
    },
    {
      "id": "B10",
      "title": "Out-of-scope lapsed policies migrated",
      "description": "The scope filter (STATUS LP with LAPSE_DT before 2019-01-01) was not applied in the Disability Income extract, so every out-of-scope DI lapsed policy was migrated. Values are otherwise correctly transformed; the rows should not exist."
    },
    {
      "id": "B11",
      "title": "Partial load: block of policies missing",
      "description": "A chunk of consecutive in-scope policies failed to load and was never retried; they have no target row."
    },
    {
      "id": "B12",
      "title": "Unregistered pending policy held back",
      "description": "A fifth pending policy (legacy STATUS PN) was held back like the MIG-142 ones but never added to the exception register, so its absence from the target is not excused."
    },
    {
      "id": "B13",
      "title": "Duplicate policy rows",
      "description": "A retried batch re-inserted some policies with new policy_ids; the same legacy_pol_no appears twice. The instance points at the second (appended) row."
    },
    {
      "id": "B14",
      "title": "Premium off by one cent, offsetting",
      "description": "annual_premium is off by exactly 0.01 on pairs of policies in the same product x billing_mode group, one up and one down, so the signed-off control totals still tie."
    },
    {
      "id": "B15",
      "title": "Premiums cross-wired between adjacent policies",
      "description": "Two pairs of adjacent policies in the same product x billing_mode group had their annual_premium values swapped. Each value is a real premium and the group totals tie, but each row carries its neighbour's premium."
    },
    {
      "id": "B16",
      "title": "Face amount misparsed with comma as decimal separator",
      "description": "A locale-dependent parser read the thousands comma as a decimal point, so '250,000.00' loaded as 250.00. The value parses and is positive, but is 1000x too small."
    },
    {
      "id": "B17",
      "title": "Issue date shifted one day early",
      "description": "A timezone conversion (local midnight to UTC, then truncated) moved issue_date back by one day on a batch of policies. Every value is a valid ISO date."
    },
    {
      "id": "B18",
      "title": "Product valid but wrong",
      "description": "Some TL20 policies were loaded as product Term 10: a valid picklist label, wrong for the row."
    },
    {
      "id": "B19",
      "title": "Policy linked to a same-name account",
      "description": "The parent lookup matched on account name instead of the CUST_NO cross-reference, so some policies hang off a different customer who happens to share the name. The parent account exists and its name matches, but it is not the account whose legacy_cust_no equals the policy's CUST_NO."
    },
    {
      "id": "B20",
      "title": "Policy re-keyed (cross-reference truncated)",
      "description": "legacy_pol_no was truncated to 9 characters on two policies (dropped last digit). Each legacy policy therefore has no target row (instance with target_row null) and each target row has no legacy counterpart (instance keyed by the truncated cross-reference). Values are otherwise correct, so control totals tie."
    },
    {
      "id": "B21",
      "title": "Parent link blank",
      "description": "account_id is blank on two policies (required field). The parent account exists in the target; the link was not populated."
    }
  ],
